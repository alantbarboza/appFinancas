<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Novo Lançamento"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_group_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/radio_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Receita"
                android:textColor="#FFFFFF" />
            <RadioButton
                android:id="@+id/radio_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Despesa"
                android:textColor="#FFFFFF"
                android:checked="true" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Valor"
            app:hintTextColor="#888888"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:background="#1E1E1E" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descrição"
            app:hintTextColor="#888888"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:background="#1E1E1E" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Categoria"
            android:textColor="#888888"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:paddingStart="12dp" />

            <ImageButton
                android:id="@+id/btn_add_category_quick"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="#1E1E1E"
                android:src="@android:drawable/ic_input_add"
                android:layout_marginStart="4dp"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_is_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="💳 Gasto no Cartão?"
            android:textColor="#FFFFFF"
            android:paddingVertical="8dp" />

        <LinearLayout
            android:id="@+id/layout_card_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cartão de Crédito"
                android:textColor="#888888"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinner_card"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="#1E1E1E"
                android:paddingStart="12dp" />

            <TextView
                android:id="@+id/text_no_card_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Vá em configurações e adicione as informações do cartão de crédito: Nome do cartão, limite, dia de fechamento e dia de vencimento."
                android:textColor="#F44336"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Fatura"
                android:textColor="#888888"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinner_invoice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="#1E1E1E"
                android:paddingStart="12dp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_installments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Número de Parcelas"
            android:visibility="gone"
            app:hintTextColor="#888888">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_installments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="#FFFFFF"
                android:background="#1E1E1E" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_is_fixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔄 Despesa Fixa (Todo mês)"
            android:textColor="#FFFFFF"
            android:paddingVertical="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_is_paid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✅ Faturado / Pago?"
            android:textColor="#FFFFFF"
            android:paddingVertical="8dp" />

        <Button
            android:id="@+id/btn_pick_date"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📅 Data Compra: 18/08/2026"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp" />

        <Button
            android:id="@+id/btn_pick_due_date"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🚨 Vencimento: --/--/----"
            android:textColor="#F44336"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Salvar" />

        <Button
            android:id="@+id/btn_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Excluir Lançamento"
            android:textColor="#F44336"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
